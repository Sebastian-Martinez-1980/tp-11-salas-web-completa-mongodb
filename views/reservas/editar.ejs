<section class="panel-formulario">
    <p class="etiqueta">EDICIÓN</p>
    <h1>
        <%= titulo %>
    </h1>

    <% if (error) { %>
        <p class="errores" role="alert">
            <%= error %>
        </p>
        <% } %>

            <form action="/reservas/<%= id %>/editar" method="post" class="formulario">
                <label for="estudiante">Estudiante</label>
                <input id="estudiante" name="estudiante" value="<%= valores.estudiante ?? '' %>" required>

                <label for="email">Email</label>
                <input id="email" name="email" type="email" value="<%= valores.email ?? '' %>" required>

                <label for="fecha">Fecha</label>
                <input id="fecha" name="fecha" type="date" value="<%= valores.fecha ?? '' %>" required>

                <label for="sala">Sala</label>
                <select id="sala" name="sala" required>
                    <option value="">Seleccioná una sala</option>
                    <% salasPermitidas.forEach(sala=> { %>
                        <option value="<%= sala %>" <%=valores.sala===sala ? "selected" : "" %>><%= sala %>
                        </option>
                        <% }); %>
                </select>

                <label for="turno">Turno</label>
                <select id="turno" name="turno" required>
                    <option value="">Seleccioná un turno</option>
                    <% turnosPermitidos.forEach(turno=> { %>
                        <option value="<%= turno %>" <%=valores.turno===turno ? "selected" : "" %>><%= turno %>
                        </option>
                        <% }); %>
                </select>

                <label for="personas">Cantidad de personas</label>
                <input id="personas" name="personas" type="number" min="1" max="6" step="1"
                    value="<%= valores.personas ?? '' %>" required>

                <div class="mb-3">
                    <label for="estado" class="form-label">Estado</label>
                    <select name="estado" id="estado" class="form-select" required>
                        <%estadosPermitidos.forEach(estado => { %>
                            <option value="<%= estado %>" <%=valores.estado===estado ? "selected" : "" %>><%= estado %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <button type="submit">Guardar cambios</button>
                <a href="/reservas/<%= id %>">Cancelar y volver al detalle</a>
            </form>
</section>