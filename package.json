    "mongoose": "^9.12.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=20.19.0"
  }
